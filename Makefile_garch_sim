executables = xgarch_sim.exe
FC     = gfortran
FFLAGS = -O0 -Wall -Werror=unused-parameter -Werror=unused-variable -Werror=unused-function -Wno-maybe-uninitialized -Wno-surprising -Wno-intrinsic-shadow -fbounds-check -static -g -fmodule-private
obj    = kind.o util.o gnuplot.o constants.o qsort.o random.o stats.o garch.o xgarch_sim.o

all: $(executables)

# Compile .f90 to .o
%.o: %.f90
	$(FC) $(FFLAGS) -c $<

xgarch_sim.exe: kind.o util.o gnuplot.o constants.o qsort.o random.o stats.o garch.o xgarch_sim.o
	$(FC) -o xgarch_sim.exe kind.o util.o gnuplot.o constants.o qsort.o random.o stats.o garch.o xgarch_sim.o $(FFLAGS)

run: $(executables)
	./xgarch_sim.exe

clean:
	rm -f $(executables) $(obj)
