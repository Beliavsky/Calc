executables = fcalc.exe
FC     = ifx
FFLAGS = /nologo /Zi /Od /check:all /traceback /fpe-all:0 /warn:all /assume:protect_parens /implicitnone /stand:f23
LDFLAGS = /link /STACK:134217728
obj    = kind.obj util.obj gnuplot.obj constants.obj qsort.obj random.obj stats.obj interpret.obj xinterpret.obj

all: $(executables)

# Compile .f90 to .obj
%.obj: %.f90
	$(FC) $(FFLAGS) -c $<

fcalc.exe: kind.obj util.obj gnuplot.obj constants.obj qsort.obj random.obj stats.obj interpret.obj xinterpret.obj
	$(FC) -o fcalc.exe kind.obj util.obj gnuplot.obj constants.obj qsort.obj random.obj stats.obj interpret.obj xinterpret.obj $(FFLAGS) $(LDFLAGS)

run: $(executables)
	./fcalc.exe

clean:
	rm -f $(executables) $(obj)

